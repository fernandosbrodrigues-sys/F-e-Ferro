# GEMINI_API_KEY: Required for Gemini AI API calls.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# APP_URL: The URL where the web server is hosted.
# APP_URL="MY_APP_URL"

# Optional initial ADMIN bootstrap credentials for the web server:
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="change-me"
# SESSION_SECRET="change-me"

# Supabase connection settings (server-side only):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=
# Legacy Supabase env vars (still supported):
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
